secrets.json

# Environment files
.env
.env.local
.env.development
.env.production

# Database files
*.db
*.db-shm
*.db-wal

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Visual Studio cache directory
**/.vs/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

